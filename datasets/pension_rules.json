    {
      "scheme_code": "GOV-PEN-010",
      "scheme_name": "Indira Gandhi National Widow Pension Scheme",
      "min_age": 40,
      "max_age": 79,
      "gender": "Female",
      "marital_status": "Widow",
      "bpl_required": true,
      "pension_amount_per_month": "₹1,000",
